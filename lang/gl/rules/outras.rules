include file="filter.include"

#########
#Regras que afectan ao modelo de lingua
#########

# Evitar o uso da segunda forma do artigo
[\b[A-Za-z]+-l(o|a)s?(\b|\s)]i
id="clGL-modling_alomorfoartigo"
hint="evitar o uso da segunda forma do artigo"

# Prefírese a terminación en -aría(s), agás palabras obrigadas como batería, galería...
[\b[A-Za-z]+erías?(\s|\b)]i
id="clGL-modling_aria"
hint="prefírese a terminación en -aría"
valid span="^(alm|bat|deb|esquec|exced|gal|hab|mensax|parec|pod|qu|quer|ref|ser|s|t)ería"

# Prefírese contracción prep(a)+art(o) -> ao , non "ó"
[\bós?\s]i
id="clGL-modling_ao"
hint="prep(a) + art(o) -> ao"

# Ca min/ti/el/ela/nos/nosoutros/vos/vosoutros/eles/elas.
[\bca\s]i
valid !before="(?!(min|ti|el|ela|si|min|nos|vos|nosoutr(o|a)s|vosoutr(o|a)s|el(e|a)s))\b"
# ese valid cacha o erro ortográfico de non marcar a contracción
# da comparativa ca + artigo determinado (a/o), polo menos nalgúns casos
id="clGL-modling_ca"
hint="usar «cá» (que + a) cando sexa imprescindíbel"

# Evitar usar ¿ e ¡ (interrogación e exclamación iniciais)
[(¡|¿)]i
id="clGL-modling_interrogacion-excl-iniciais"
hint="evitar usar sinais iniciais de interrogación ou exclamación"

# avisar de «tódolos»
[\btódol(a|o)s]i
id="noPT-gl_tódolos"
hint="«tódolos» -> «todos os»?"

# avisar de «carpeta»
[\bcarpeta]i
id="noPT-gl_carpeta"
hint="«carpeta» -> «cartafol»?"

#####
# Gramática (this shouldn't be here, but the grammar checker is not always used as should be...)
#####

# «ir a infinitivo» -> «ir ìnfinitivo»
[\b(ir|ías?|vou|vas|vai)\sa\s\w+[aei]r\b]i
id="noPT-gl_ir+a+infinitivo"
hint="«ir a infinitivo» -> «ir ìnfinitivo»"

#####
# Regras específicas de GNOME
#####

# translator credits
{^translator-credits$}i
id="gnome_translator credits"
hint="comprobar o formato dos creditos da tradución"

#descarta o uso de «achar» en favor de «encontrar»
[\b[aá]ch(?!eg)[aáeéoó]]i
id="gnome-gl_achar"
hint="achar -> encontrar"

#descarta o uso de «apropiado» en favor de «axeitado»
[\bapropriad]i
id="gnome-gl_apropiado"
hint="achar -> axeitado"

#comprobar caixa de «GNOME»
[\b(G|g)nome\s]
# valid msgid="\bgnome"
id="gnome-gl_GNOME"
hint="gnome->GNOME"

#descarta o uso de «mudar» en favor de «trocar»
[\bmud(a|o|e)]i
id="gnome-gl_mudar"
hint="mudar -> trocar"

#descarta o uso de «predefinido» en favor de «predeterminado»
[\bpredefinid]i
id="gnome-gl_predefinido"
hint="predefinido -> predeterminado"

#substituir tres puntos seguidos por unhas reticencias U2026
[\.{3}]i
id="gnome-gl_reticencias"
hint="... -> …"

#####
# Regras específicas de GNOME para terminoloxía
#####

# «shell» -> «shell» ou «intérprete de ordes»
{\bshell}i
id="gnome_shell"
valid msgstr="\bshell"
valid msgstr="\bint(e|é)rpretes?\sde\sordes?"
hint="shell -> shell ou interprete de ordes"

# «validation,validity» -> «validación»
{\bvalid(ation|idit(y|ies))}i
id="gnome_validation"
valid msgstr="\bvalidación"
hint="validation -> validación"

# «validate» -> «validar»
{\bvalidat(e|es|ed|ing)}i
id="gnome_validate"
valid msgstr="\bvalida" !before="dor"
hint="validate -> validar"

# «validator» -> «validador»
{\bvalidator}i
id="gnome_validator"
valid msgstr="\bvalidador"
hint="validator -> validador"

# «validación» -> «validation»
[\bvalidación]i
id="gnome-dual_validation"
hint="validación -> validation"
valid msgid="\bvalidation"



#####
# Regras específicas de KDE para modelo de lingua
#####

## pronome mal colocado ?
#[\ba\s\S+á\b]i
#valid after="\bnon\s"
#id="clGL_pronome mal posto"
#hint="posíbel orde inversa dun pronome"

# «lineal» → «linear»
[\blinea(l|is)]i
id="clGL_lineal"
hint="«lineal» → «linear»"

# regra comentada porque non dá achadegas
##descarta o uso de «colar» en favor de «(a)pegar»
#[\bcol(a|e|o)(?!(c|m|re|ri|ra|ps|b|q|x|nia|fón))]i
#valid msgstr="\bcolor"
#valid msgstr="\bcola" msgid="\b((de|en)queue|queue|tail|spool)"
#id="clGL-all_colar"
#hint="colar -> (a)pegar"

#coidado cos derivados de licenza que trocan o z
[\blicenci(?=(oso|osa|osamente|atura|amento|ado|ada|ados|ada)s)]i
id="clGL-all_licenza"
hint="algúns derivados de licenza trocan o «z» por «cia»"

#descarta o uso de «ocorrencia» en favor de «aparición»
[\boc(o|u)rrencia]i
id="clGL-all_ocorrencia"
hint="ocorrencia -> aparición"

#descarta o uso de «ocorreu» en favor de «produciuse»
[\bocorreu]i
id="clGL-all_ocorreu"
hint="ocorreu -> produciuse"

#descarta o uso de «ubicación, ubicar» en favor de «localización, localizar»
[\bubica]i
id="clGL-all_ubicación"
hint="«ubicación, ubicar» -> «localización, localizar»"

#descarta o uso de «xerir» en favor de «xestionar»
[\bxeri(?!(nga|có))]i
id="clGL-all_xerir"
hint="xerir -> xestionar"

# preferir «se han examinar/ han ser examinados» no canto de «serán examinados»
[\b\w+rán?\s[A-Za-z]+ad(o|a)s?]i
valid !span="\b(ser|estar)án"
#valid span="\bverán"      # admitir «verán+v(participio)
id="clGL-all_serán+participio"
hint="«serán+participio» -> «han ser participio», «examinaránse» ou «ha infinitivo»"

#####
# Expresións frecuentes
#####

# «enable this option»
{\benable\sthis\s(option|checkbox)}i
id="expression_enable this option| checkbox"
valid !after="\bif\syou"
valid msgstr="\bescoll(a|er)\sesta\sopción"
hint="enable this option = escolla/er esta opción"

# «when/if this option/checkbox is enabled»-> «se escolleu/sinalou esta opción»
{\b(when|if)\sthis\s(option|checkbox)\sis\senabled}i
id="expression_when|if this option|checkbox is enabled"
valid msgstr="\bse\sactiva\sesta\sopción"
hint="when|if this option|checkbox is enabled -> se escolle esta opción"

# «enable»
{\b(when|if)\sthis\sis\senabled}i
id="expression_when|if this is enabled"
valid msgstr="\bse\sactiva\sesta\sopción"
hint="is this is enabled -> se activa esta opción"

# «enable»
{\b(if|when)\senabled}i
id="expression_when/if enabled"
valid msgstr="\bse\sescolle\sesta\sopción"
hint="when/if enabled -> se escolle esta opción"

# «disable this option/checkbox»
{\bdisable\sthis\s(option|checkbox)}i
valid after="if\syou\s"
id="expression_disable this option/checkbox"
valid msgstr="\bdesmarque\sesta\sopción"
hint="disable this option/checkbox -> desmarque esta opción"

# «when/if this option/checkbox is disabled»
{\b(when|if)\sthis\s(option|checkbox)\sis\sdisabled}i
id="expression_when/if this option/checkbox is disabled"
valid msgstr="\bse\sesta\sopción\snon\sestá\s(escollid|marcad)a"
valid msgstr="\bse\snon\sescolle\sesta\sopción"
hint="when/if this option/checkbox is disabled -> se esta opción non está escollida/marcada"

# «when/if this is disabled»
{\b(when|if)\sthis\sis\sdisabled}i
id="expression_when this is disabled"
valid msgstr="\bse\sesta\sopción\snon\sestá\s(escollid|marcad)a"
hint="when/if this is disabled -> se esta opción non está escollida/marcada"

# «if/when disabled»
{\b(if|when)\sdisabled}i
id="expression_if/when disabled"
valid msgstr="\bse\sdesactiva\sesta\sopción"
hint="if/when disabled -> se desactiva esta opción"

# «when selected»
{\bwhen\sselected}i
id="expression_when selected"
valid msgstr="\bse\so\sescolle"
valid msgstr="\bse\sescolle\sesta\sopción"
hint="when selected -> se o escolle (experimental)"

# «...not found.» -> «Non se atopou...»
{\b\w+\snot\sfound\.}i
id="expression_not found."
valid msgstr="\bNon\s((se\satop(ou|aron))|(foi\sposíbel\satopar))\s(\w+\s)+\w+"
hint="...not found. -> Non se atopou/foi posíbel atopar ... ..."

# there was an error ....
{\bthere\swas\san?}i
valid after="\bif\s"
valid before="\sproblem"    # por mor da cacofonía: produciuse un problema
id="expression_there-was-an-error"
valid msgstr="\bProduciuse\sun(\b|s|ha)"
hint="There was an error -> Produciuse un erro"

#####
# Fin das regras específicas de KDE
#####

#####
# Regras específicas de KDE para terminoloxía
#####

# «accept» -> «aceptar»
{\baccept}i
id="kde_accept"
valid msgstr="\bacept"
valid msgstr="\bacéptase"
hint="accept = aceptar"

# «aceptar» -> «accept»
[\bacept]i
id="kde-dual_accept"
valid msgid="\baccept"
valid msgid="\bOK\b"
valid msgid="\bagree"
hint="aceptar = accept"

## «append» -> «amecer»
#{\bappend}i
#valid before="ix"
#id="kde_append"
#valid msgstr="\bamecer"
#hint=" append -> amecer"

# «amecer» -> «append»
[\bamec]i
id="kde-dual_append"
valid msgid="\bappend"
hint=" amecer -> append"

# «not enabled»
{\bnot enabled\b}
valid after="\bif\s"
id="kde_not enabled"
valid msgstr="\bdesactivad(o|a)"
valid msgstr="\bnon\sestá\sactivad(o|a)"
hint="not enabled -> desactivado"

# Agora Non me parece tan boa idea esta regra
## «enable/disable» -> «conmutar»
#{\benable/disable}i
#id="kde_enabledisable"
#valid msgstr="\bconmuta"
#hint="enable/disable = conmutar"

# «encounter» -> «atopar» and not «achar»
{\bencounter}i
id="kde_encounter"
valid msgstr="\batop"
valid !msgstr="\bach"
hint="encounter -> atopar"

#«acontecemento» -> «event»
[\bacontecemento]i
id="kde-dual_event"
valid msgid="\bevent"
hint="acontecemento-> event"

# «node» -> «vértice»
{\bnodes?\b}i
# valid after="free"
# valid after="\bi"
# valid after="\ba"
# valid after="\bk"
id="kde_node"
valid env="graph_theory" msgstr="vértices?"
valid !env="graph_theory" msgstr="\bnodos?"
hint="«node» -> «vértice» (en teoría de grafos), ou «nodo»"

# «nodo» -> «node»
[\bnodos?\b]i
id="kde-dual_node(2)"
valid msgid="nodekit"
valid msgid="nodename"
valid msgid="\bnodes?\b" !env="graph_theory"
hint="«nodo» -> «node»"

# «print» -> «imprimir», «mostra»
{\bprint}i
valid !before="ing"
valid !before="er"
valid before="screen"
valid before="\spreview"
id="kde_print"
valid msgstr="\bimprim"
valid msgstr="\bimpresión"
valid msgstr="\bimpres(o|a)"
valid msgstr="\bmostr"
valid before="\ssystem" msgstr="\bsistema\sde\simpresión"
hint="print = imprimir, impresión, impreso ou mostrar"

# «printing» -> «imprimir», «impresión»
{\bprinting}i
id="kde_printing"
valid msgstr="\bimpresión"
valid msgstr="\bimprim"
hint="printing = imprimir, impresión"

# «imprimir» -> «print»
[\bimprim]i
id="kde-dual_print"
valid msgid="\becho(e[ds]|ing)?\b"
valid msgid="\bprint(?!er)"
valid after="\bversións?\spara\s" msgid="\bprinters?\sfriendly\b"
hint="imprimir = print"



# «edge» -> «aresta»
{\bedges?}i
valid !env="graph_theory"
id="kde_edge(graph_theory)"
valid msgstr="arestas?"
valid after="self-" msgstr="lazos?"
hint="«edge» -> «aresta» (en teoría de grafos); «self-edge» ->  «lazo»"

# «aresta» -> «edge»
[arestas?]i
valid !env="graph_theory"
id="kde-dual_edge(graph_theory)"
valid msgid="edges?"
hint="«aresta» -> «edge» (en teoría de grafos)"

# «lazo» -> «self-edge»
[lazos?]i
valid !env="graph_theory"
id="kde-dual_edge2(graph_theory)"
valid msgid="self-edges?"
hint="«lazo» -> «self-edge» (en teoría de grafos)"

# «vértice» -> «node»
[vértices?]i
valid !env="graph_theory"
id="kde-dual_node(graph_theory)"
valid msgid="nodes?"
hint="«vértice» -> «node» (en teoría de grafos)"

# «conceal» → «esconder»
{\bconceal(s|ed|ing)?}i
id="aaPT_conceal"
valid msgstr="\bescond"
hint="«conceal» → «esconder»"

# «esconder» → «conceal»
[\bescond]i
id="aaPT_esconder"
valid msgid="\bconceal"
valid msgid="\bescond"
hint="«esconder» → «conceal»"

#####
# Fin das regras específicas de KDE para terminoloxía
#####

# Regras arbitrarias #--------------------------------------------------------#
#
# Regras propostas, alleas a acordos da comunidade que cada quen pode usar ou
# non segundo lle pareza.


# http://trasno.gal/lista-de-correo-2/?subpage=mailstermail&id=6858 (2019-09-04)
# Incompatíbel con «proposta-app-aplicación».

{\b(web)?apps?\b}i
id="proposta-app-apli"
hint="app → apli"
valid msgstr="\baplis?\b"
valid msgstr="\bspp\b"  # arcsec per pixel → segundos de arco por píxel


# Incompatíbel con «proposta-app-apli».

{\b(web)?apps?\b}i
id="proposta-app-aplicación"
hint="app → aplicación"
valid msgstr="\baplicacións?\b"
valid msgstr="\bspp\b"  # arcsec per pixel → segundos de arco por píxel


{\barg(ument)?s?\b}i
id="proposta-argument"
hint="arg, argument → argumento"
valid msgstr="\bargumentos?\b"


{\bback-up\b}i
id="proposta-back-up"
hint="back-up → de salvagarda"
valid msgstr="\bde\s*salvagarda\b"


{\bback(ed|ing|s)?\s+up\b}i
id="proposta-backing-up"
hint="back up → salvagardar"
valid msgstr="\bsalvag[aá]rd[aáeéoó]"


{\bbackups?\b}i
id="proposta-backup"
hint="backup → salvagarda"
valid msgstr="\bsalvagardas?\b"


{\bbook(ed|ing|s)?\b}i
id="proposta-book"
hint="book → libro, reserva, reservar"
valid msgstr="\blibros?\b"
valid msgstr="\bres[eé]rv[aáeéoó]"
valid msgstr="\bbooks?\b"  # p. ex. Google Books
valid after="\baddress\s+"
valid after="\bcomic\s+"


{\bbuild\s*sets?\b}i
id="proposta-build-set"
hint="build set → grupo de construción"
valid msgstr="\bgrupos?\s+de\s+construción\b"


# Baseada na escolla da RAG posterior á trasnada na que se chegou a un acordo
# sobre o termo.
# Incompatíbel con «trasno-chat» e «trasno-chat_reverse».

{\bchat(t?(ed|ing)|s)?\b}i
id="proposta-chat"
hint="chat → charla, charlar"
valid msgstr="\bch[aá]rl[aáeéoó]"

{\bchat\s*rooms?\b}i
id="proposta-chatroom"
hint="chatroom → sala de charla"
valid msgstr="\bsalas?\s+de\s+charla\b"


[\bcoma\s(?!(min|vostede|ti|el|si|min|ela|nós|vós|nosoutr[ao]s|vosoutr[ao]s|el[ae]s))]i
id="proposta-coma-como"
hint="coma → como (hai casos nas que *debe* usarse «coma», consúltese o dicionario)"
valid msgid="\bcomma\b"
valid after="\bpuntos?\s*e\s*" # «puntos e comas»
valid after="\bda\s*"         # «algo da coma» → refírese ao «,»-
valid after="\bunha\s*"       # «unha coma»
valid before="\s*flotante\b"
valid before="\s*como\b"  # «coma como separador»


{(\bare\syou\ssure\syou\swant\sto(\s(\w+|\W+))+\?|\bdo\syou\sreally(\s(\w+|\W+))+\?)}i
id="proposta-confirmación"
hint="«Are you sure you want to», «Do you really» → «Seguro que quere»"
valid msgstr="\bseguro\s*que\s*queres?\b"


[\ba\s+[ao]s?\b]i
id="proposta-contracción-a"
hint="Hai un «a» sen contraer"


[\bcon\s+([ao]s?|un(ha)s?)\b]i
id="proposta-contracción-con"
hint="Hai un «con» sen contraer"


[\bde\s+([ao]s?|un(ha)s?|est?[ae]s?|aquel(as?|es)?|algúns?|algunhas?|outr[ao]s?)\b]i
id="proposta-contracción-de"
hint="Hai un «de» sen contraer"


[\ben\s+([ao]s?|un(ha)s?|est?[ae]s?|aquel(as?|es)?|algúns?|algunhas?|outr[ao]s?)\b]i
id="proposta-contracción-en"
hint="Hai un «en» sen contraer"


[\bpor\s+[ao]s?\b]i
id="proposta-contracción-por"
hint="Hai un «por» sen contraer"


{\bcoverages?\b}i
id="proposta-coverage"
hint="coverage → cobertura"
valid msgstr="\bcoberturas?\b"


{\cycl(e[ds]?|ing)\b}i
id="proposta-cycle"
hint="cycle → circular"
valid msgstr="\bcirc[uú]l[aáeéoó]"


# daemon → servizo
# Incompatíbel con «preacordo-daemon-daemon».

{\bdaemons?\b}i
id="proposta-daemon-servizo"
hint="daemon → servizo"
valid msgstr="\bservizos?\b"


{\bembedded\b}i
id="proposta-embedded"
hint="embedded → incrustada"
valid msgstr="\bincr[uú]st[aáeéoó]"


{\bend-to-end\b}i
id="proposta-end-to-end"
hint="end-to-end → de extremo a extremo"
valid msgstr="\bde\s*extremo\s*a\s*extremo\b"


[\bequipos?\s+de\sadministración\b]i
id="proposta-equipo-de-administración"
hint="equipo de administración → equipo administrador"


[\bequipos?\s+de\sdesenvolvemento\b]i
id="proposta-equipo-de-desenvolvemento"
hint="equipo de desenvolvemento → equipo desenvolvedor"


[\bequipos?\s+de\smantemento\b]i
id="proposta-equipo-de-mantemento"
hint="equipo de mantemento → equipo mantedor"


[\bequipos?\s+de\sprogramación\b]i
id="proposta-equipo-de-programación"
hint="equipo de programación → equipo programador"


[\bequipos?\s+de\ssecretaría\b]i
id="proposta-equipo-de-secretaría"
hint="equipo de secretaría → equipo secretario"


[\bestá\s*segur[ao]\s*de\s*que\s*quere\b]i
id="proposta-está-seguro"
hint="está seguro de que quere → seguro que quere"


{\bevents?\b}i
id="proposta-event-evento"
hint="event → evento"
valid msgstr="\beventos?\b"
valid msgstr="\bfestas?\b"  # p. ex. summer splash event → festa da auga


{\bin(-|\s*)line\b}i
id="proposta-inline"
hint="inline → intercalar, in situ, incorporada [no corpo dunha mensaxe de correo electrónico]"
valid msgstr="\binterc[aá]l[aáeéoó]"
valid msgstr="\b(da|en|na|nunha)\s*liña\b"
valid msgstr="\bin\s*situ\b"
valid msgstr="\bincorporad[ao]s?\b"


[\bmais\b]i
id="proposta-mais-pero"
hint="mais → pero (contraposición), máis (aumento)"


{\boffsets?\b}i
id="proposta-offset"
hint="offset → desprazamento, diferenza"
# Movemento, p. ex. dun texto, con respecto á súa posición inicial.
valid msgstr="\bdesprazamentos?\b"
# Cantidade (p. ex. de tempo) de diferenza (positiva ou negativa) con respecto
# a un valor de referencia.
valid msgstr="\bdiferenzas?\b"
valid msgstr="\bposicións?\b"  # p. ex. error at offset %1 → erro na posición %1
valid msgstr="\bpuntos?\b"  # p. ex. truncation offset → punto de corte


# Dado que «abertura» ten máis acepcións que «apertura», preferir esta última
# para as acepcións que teñen en común.

[\baberturas?\b]i
id="proposta-opening-abertura-apertura"
hint="abertura (opening) → apertura"
valid msgstr="\baperturas?\b"


[\bp\.ex\.\b]
id="proposta-p-ex"
hint="p.ex. → p. ex."


{\bparam(eter)s?\b}i
id="proposta-parameter"
hint="param, parameter → parámetro"
valid msgstr="\bparámetros?\b"


[\bpor\s*defecto\b]i
id="proposta-por-defecto"
hint="por defecto → predeterminada"


# LanguageTool detecta a maioría de casos nos que se separa o % do número, que
# non é correcto en galego. Esta regra permite detectar casos que usan un
# marcador de posición.

[%[\da-z]\s+%(?![\da-z])]i
id="proposta-porcentaxe"
hint="Escriba a porcentaxe sen espazos (estilo estándar)."  # Mensaxe copiada de LT


# Incompatíbel con «preacordo-print_preview».

{\bprint\s*previews?\b}i
id="proposta-print-preview"
hint="print preview → vista de impresión"
valid msgstr="\bvistas?\s*de\s*impresión\b"


{\bresponsive\b}i
id="proposta-responsive"
hint="responsive → adaptábel"
valid msgstr="\badaptábe(l|is)\b"


[\bsecretari[ao]s?\b]i
id="proposta-secretario"
hint="secretario → [persoa] secretaria, [equipo] secretario, secretaría"
valid after="\bpersoas?\s+" span="secretarias?"
valid after="\bequipos?\s+"


{\bstrip(ped|ing|s)?\b}i
id="proposta-strip"
hint="strip → rozar (quitar texto innecesario)"
valid msgstr="\br[oó](z[aáoó]|c[eé])"


{\bsubmit(ted|ing|s)?\b}i
id="proposta-submit"
hint="submit → entregar"
valid msgstr="\bentr[eé]g([aáoó]|u[eé])"


[(\b(contigo|ti|teu|túa)\b|\b(podes|queres|tes|uses|únete)\b)]i
id="proposta-ti"
hint="https://trasno.gal/colaborar/traducir/recursos/estilo/trato/"
valid env="docs"
valid env="game"
valid env="informal"
valid env="kids"
valid env="website"


{\btrim(m?(ed|ing)|s)?\b}i
id="proposta-trim"
hint="trim → recortar (quitar texto dos extremos)"
valid msgstr="\brec[oó]rt[aáeéoó]"


{\bunmut(e[ds]?|ing)\b}i
id="proposta-unmute"
hint="unmute → activar o son"
valid msgstr="\bact[ií]v[aáeéoó]\S*\s*o\s*son\b"


[\bválid[ao]s?\b]i
id="proposta-válido-correcto"
hint="válido → correcto"


[\bv[oó]lv[aáeéiíoó]\S*\s+a\s+\S*[aei]r\b]i
id="proposta-volver-a"
hint="volver a [infinitivo] → volver [infinitivo]"


[(\b(vostede)\b|\b(únase)\b)]i
id="proposta-vostede"
hint="https://trasno.gal/colaborar/traducir/recursos/estilo/trato/"
valid !env="game"


{\baddress\s*books?\b}i
id="proposta-en-address-book"
hint="address book → axenda de enderezos"
valid msgstr="\baxendas?\s*de\s*enderezos\b"

{\balternates?\b}i
id="proposta-en-alternate"
hint="alternate → alternar, outra, por quendas, variante"
valid msgstr="\balt[eé]rn[aáeéoó]"
valid msgstr="\boutr[ao]s?\b"
valid msgstr="\bpor\s*quendas\b"
valid msgstr="\bvariantes?\b"

{\bartifacts?\b}i
id="proposta-en-artifact"
hint="artifact → artefacto, defecto [visual]"
valid msgstr="\bartefactos?\b"
valid msgstr="\bdefectos?\b"

{\b(micro)?blogs?\b}i
id="proposta-en-blog"
hint="blog → bitácora"
valid msgstr="\b(micro)?bitácoras?\b"

{\bboarding\s*pass(es)?\b}i
id="proposta-en-boarding-pass"
hint="boarding pass → tarxeta de embarque"
valid msgstr="\btarxetas?\s*de\s*embarque\b"

{\bboot\s*splash\s*screens?\b}i
id="proposta-en-boot-splash-screen"
hint="boot splash screen → pantalla de arranque"
valid msgstr="\bpantallas?\s*de\s*arranque\b"

{\bbranch(es)?\b}i
id="proposta-en-branch"
hint="branch → rama"
valid msgstr="\bramas?\b"
valid msgstr="\bdesvíos?\b"

{\bbuilt-in\b}i
id="proposta-en-built-in"
hint="built-in → incluída"
valid msgstr="\bincl[uú][aáeéiíoó]"

{\bclear(ed|ing|s)?\b}i
id="proposta-en-clear"
hint="clear → baleirar (a lista de), borrar (p. ex. un texto, unha mensaxe), eliminar (p. ex. o historial), limpar (algo que está sucio)"
valid msgstr="\bbal[eé]ir[aáeéoó]"
valid msgstr="\bb[oó]rr[aáeéoó]"
valid msgstr="\bl[ií]mp[aáeéoó]"
valid after="\bma(de|k(es?|ing))\b.*" msgstr="\bd[eé]ix[aáeéoó]\S*?\s*claro\b"  # make clear → deixar claro
valid before="$|.*?\b(bookmarks?|histor(y|ies))\b" msgstr="\belim[ií]n[aáeéoó]\S*"  # clear history → eliminar o historial
valid before="$|.*?\b(all|data|filters?|messages?|stat(es?|us(es)?)|text)\b" msgstr="\bb[oó]rr[aáeéoó]\S*"  # clear message → borrar a mensaxe
valid before="$|.*?\bselections?\b" msgstr="\ban[uú]l[aáeéoó]\S*"  # clear selection → anular a selección
valid before="$|.*?\b(stat(istic)?s|statistical\s*data)\b" msgstr="\belim[ií]n[aáeéoó]\S*"  # clear statistics → eliminar as estatísticas
valid span="clear" before="\s*text\b"  msgstr="\btexto\s+simple\b"

{\bcloudiness\b}i
id="proposta-en-cloudiness"
hint="cloudiness → nebulosidade"
valid msgstr="\bnebulosidade\b"

{\bcollaps(e[ds]?|ing)\b}i
id="proposta-en-collapse"
hint="collapse → pregar"
valid msgstr="\bpr[eé]g([aáoó]|u[eé])"
valid msgstr="\bcol[aá]ps[aáeéoó]"

{\bcore\s*developers?\b}i
id="proposta-en-core-developer"
hint="core developer → [persoa] desenvolvedora principal, [equipo] desenvolvedor principal, desenvolvemento principal"
valid msgstr="\bdesenvolvedoras?\s*principa(l|is)\b"
valid msgstr="\bequipos?\s+desenvolvedor(es)?\s+principa(l|is)\b"
valid msgstr="\bdesenvolvementos?\s*principa(l|is)\b"

{\bCPUs?\b}i
id="proposta-en-cpu"
hint="CPU → procesador"
valid msgstr="\bprocesador(es)?\b"

{\bdatabases?\b}i
id="proposta-en-database"
hint="database → base de datos"
valid msgstr="\bbases?\s*de\s*datos\b"

{\bdecibels?\b}i
id="proposta-en-decibel"
hint="decibel → decibel (plural: decibeles)"
valid msgstr="\bdecibel(es)?\b"

{\bdirectory\s*servers?\b}i
id="proposta-en-directory-server"
hint="directory server → servidor de nomes"
valid msgstr="\bservidor(es)?\s*de\s*nomes\b"

{\bdirectory\s*services?\b}i
id="proposta-en-directory-service"
hint="directory service → servizo de nomes"
valid after="\bpodcast\s*"
valid msgstr="\bservizos?\s*de\s*nomes\b"

{\bdisplay\s*names?\b}i
id="proposta-en-display-name"
hint="display name → nome visual"
valid msgstr="\bnomes?\s*visua(l|is)\b"
valid msgstr="\bam[oó]s[aáeéoó]\S*\s*os?\s*nomes?\b"

{\bemojis?\b}i
id="proposta-en-emoji"
hint="emoji → expresión"
valid msgstr="\bexpresións?\b"

{\benvironments?\b}i
id="proposta-en-environment"
hint="environment → contorno"
valid after="\b(familiar|welcoming)\s*"
valid msgstr="\bcontornos?\b"
valid msgstr="\bmedio\s*ambiente\b"
valid msgstr="\bmedioambienta(l|is)\b"

{\bexpand(ed|ing|s)?\b}i
id="proposta-en-expand"
hint="expand → expandir"
valid msgstr="\bexpand(ed|ing|s)?\b"
valid msgstr="\bexp[aá]nd[aáeéiíoó]"
valid msgstr="\bexpansións?\b"
valid msgstr="\baum[eé]nt[aáeéoó]"
valid msgstr="\bsubstit[uú][aáeéiíoó]"

{\bfreezing\b}i
id="proposta-en-freezing"
hint="freezing → xélida"
valid msgstr="\bxélid[ao]s?\b"
valid msgstr="\bconxelar\b"
valid msgstr="\bconxelación\b"

{\bgantt\b}i
id="proposta-en-gantt"
hint="Gantt → Gantt"
valid msgstr="\bGantt\b"

{(?i)\bgantt\s*charts?\b}
id="proposta-en-gantt-chart"
hint="Gantt chart → diagrama de Gantt"
valid msgstr="\b[Dd]iagramas?\s*de\s*Gantt\b"

{\bhackers?\b}i
id="proposta-en-hacker"
hint="hacker → [persoa] intrusa, [equipo] intruso, intrusión"
valid msgstr="\bintrusas?\b"
valid msgstr="\bequipos?\s+intrusos?\b"
valid msgstr="\bintrusións?\b"

{\bhex\s*editors?\b}i
id="proposta-en-hex-editor"
hint="hex editor → editor de binario"
valid msgstr="\beditor(es)?\s*de\s*binario\b"

{\binternet\s*browsers?\b}i
id="proposta-en-internet-browser"
hint="internet browser → navegador web"
valid msgstr="\bnavegador(es)?\s*web\b"

{\bissuers?\b}i
id="proposta-en-issuer"
hint="issuer → expedidor"
valid msgstr="\bexpedidor(es)?\b"

{\blooks?[\s-]*and[\s-]*feels?\b}i
id="proposta-en-look-and-feel"
hint="look and feel → xeito"
valid msgstr="\bxeitos?\b"

{\bluminance\b}i
id="proposta-en-luminance"
hint="luminance → luminancia"
valid msgstr="\bluminancia\b"

{\bmenu\s*items?\b}i
id="proposta-en-menu-item"
hint="menu item → entrada de menú"
valid msgstr="\bentradas?\s*de\s*menú\b"

{\blight\s*tables?\b}i
id="proposta-en-light-table"
hint="light table → mesa de luz"
valid msgstr="\bmesas?\s*de\s*luz\b"

{\boverrid(es?|den|ing)?\b}i
id="proposta-en-override"
hint="override → sobredefinir"
valid msgstr="\bsobredef[ií]n[aáeéiíoó]"

{\bpark(ed|ing|s)?\b}i
id="proposta-en-park"
hint="park → aparcar"
valid msgstr="\bap[aá]r(c[aáoó]|qu[eé])"

{\bpipes?\b}i
id="proposta-en-pipe"
hint="pipe → canalizar, cano, de canalización"
valid msgstr="\bcanos?\b"
valid msgstr="\bcanal(?!izacións?\b)[ií]z[aáeéoó]"
valid msgstr="\bde canalización\b"

{\bpipings?\b}i
id="proposta-en-piping"
hint="piping → canalización"
valid msgstr="\bcanalizacións?\b"

{\bplasmoids?\b}i
id="proposta-en-plasmoid"
hint="plasmoid → trebello"
valid msgstr="\btrebellos?\b"

{\bpopups?\b}i
id="proposta-en-popup"
hint="popup → xanela emerxente"
valid after="\bpreview\s*"
valid before="\s*(menu|note|notice)s?\b"
valid msgstr="\bxanelas?\s*emerxentes?\b"

{\bpopup\s*menus?\b}i
id="proposta-en-popup-menu"
hint="popup menu → menú emerxente"
valid msgstr="\bmenús?\s*emerxentes?\b"

{\bpost(?!\s*mortem\b)(ed|ing|s)?\b(?!-)}i
id="proposta-en-post"
hint="post → publicar, publicación"
valid before="\s*offices?\b"
valid before="\s*process"
valid msgstr="\bpost\b"
valid msgstr="\bpubl[ií](c[aáoó]|qu[eé])"
valid msgstr="\bpublicacións?\b"

{\bprivacy\s*polic(y|ies)\b}i
id="proposta-en-privacy-policy"
hint="privacy policy → directiva de privacidade"
valid msgstr="\bdirectivas?\s*de\s*privacidade\b"

{\brequests?\b}i
id="proposta-en-request"
hint="request → solicitude"
valid msgstr="\bsolicitudes?\b"
valid msgstr="\bsolic[ií]t[aáeéoó]"
valid after="\bat\s*your\s*" msgstr="\bno\s*seu\s*nome\b"
valid after="\bon\s*" msgstr="\bbaixo\s*demanda\b"

{\bretweet(ed|ing|s)?\b}i
id="proposta-en-retweet"
hint="retweet → promover"
valid msgstr="\bprom[oó]v[aáeéiíoó]"

{\bscripting\b}i
id="proposta-en-scripting"
hint="scripting → guionización"
valid msgstr="\bguionización\b"

{\bsets?\b(?!(\s*(as\s*default|focus|phrase)|.*?\s+(on|to|true|up)|-up)\b)}i
id="proposta-en-set"
hint="set → definir"
valid after="\bcharacter\s*"
valid after="^If\s*" before="\s*,"
valid before="\s*as\s*wallpaper"  # usar de fondo
valid msgstr="\bsets?\b"
valid msgstr="\bdef[ií]n[aáeéiíoó]"
valid msgstr="\b(sub)?conxuntos?\b"  # Matemáticas
valid msgstr="\b(sub)?grupos?\b"
valid msgstr="\blotes?\b"
valid msgstr="\bseries?\b"
valid msgstr="\bxogos?\b"

{\bsharpen(ed|ing|s)?\b}i
id="proposta-en-sharpen"
hint="sharpen → enfocar"
valid msgstr="\benf[oó](c[aáoó]|qu[eé])"

{\bsliders?\b}i
id="proposta-en-slider"
hint="slider → control esvaradío"
valid msgstr="\bcontrol\s*esvaradío\b"
valid msgstr="\bcontrois\s*esvaradíos\b"

{\bslugs?\b}i
id="proposta-en-slug"
hint="slug → alias"
valid msgstr="\balias\b"

{\bsockets?\b}i
id="proposta-en-socket"
hint="socket → toma"
valid msgstr="\btomas?\b"

{\bsplash\s*screens?\b}i
id="proposta-en-splash-screen"
hint="splash screen → pantalla de inicio"
valid after="boot\s*"
valid msgstr="\bpantallas?\s*de\s*inicio\b"

{\bstarting\s*points?\b}i
id="proposta-en-starting-point"
hint="starting point → punto de partida"
valid msgstr="\bpuntos?\s*de\s*partida\b"

{\bsys(tem)\s*trays?\b}i
id="proposta-en-system-tray"
hint="system tray → área de notificación"
valid msgstr="\báreas?\s*de\s*notificación\b"

{\btime\s*lines?\b}i
id="proposta-en-timeline"
hint="timeline → cronoloxía"
valid after="-"  # p. ex. current-time line → liña deste intre
valid msgstr="\bcronoloxías?\b"

{\btimestamps?\b}i
id="proposta-en-timestamp"
hint="timestamp → marca de tempo"
valid msgstr="\bmarcas?\s*de\s*tempo\b"

{\b(tocs?|tables?\s*of\s*contents)\b}i
id="proposta-en-toc"
hint="ToC, table of contents → índice"
valid msgstr="\bíndices?\b"

{\btoggl(e[ds]?|ing)\b}i
id="proposta-en-toggle"
hint="toggle → conmutar"
valid msgstr="\bconm[uú]t[aáeéoó]"
valid msgstr="\binv[eé]rt[aáeéiíoó]"
valid msgstr="\btoggl(e[ds]?|ing)\b"
valid before=".*?\s*on/off" msgstr="ac[eé]nd[aáeéiíoó]\S*\s*ou\s*ap[aá]g([aáoó]|u[eé])"

{\btooltips?\b}i
id="proposta-en-tooltip"
hint="tooltip → indicación emerxente"
valid msgstr="\bindicacións?\s*emerxentes?\b"

{\btrigger(?!\s*warnings?\b)s?\b}i
id="proposta-en-trigger"
hint="trigger → detonante, provocar, disparar, activar"
valid msgstr="\bdetonantes?\b"
valid msgstr="\bdisp[aá]r[aáeéoó]"
valid msgstr="\bprov[oó](c[aáoó]|qu[eé])"
valid msgstr="\bl[eé]v[aáeéoó]\S*\s+(a|ás?|aos?)\b"
valid msgstr="\bact[ií]v[aáeéoó]"

{\bunpark(ed|ing|s)?\b}i
id="proposta-en-unpark"
hint="unpark → desaparcar"
valid msgstr="\bdesap[aá]r(c[aáoó]|qu[eé])"

{\bvaults?\b}i
id="proposta-en-vault"
hint="vault (encrypted container) → cofre"
valid msgstr="\bcofres?\b"

{\bverbose\b}i
id="proposta-en-verbose"
hint="verbose → verbosa"
valid msgstr="\bverbos[ao]s?\b"

{\bwall\s*-?\s*papers?\b}i
id="proposta-en-wallpaper"
hint="wallpaper → fondo"
valid msgstr="\bfondos?\b(?!\s*de\s*(escritorio|pantalla)\b)"
valid msgstr="\bwall\s*-?\s*papers?\b"

{\bworkarounds?\b}i
id="proposta-en-workaround"
hint="workaround → apaño"
valid msgstr="\bapaños?\b"

[^a\s+(?!singular\b)\w+[aei]r\b]i
id="proposta-gl-a-infinitivo"
hint="A [infinitivo] → [Xerundio]"

[\badministrador(es)?\b]i
id="proposta-gl-administrador"
hint="administrador → [persoa] administradora, [equipo] administrador, administración"
valid after="\bequipos?\s+"

[\balmacenaxes?\b]i
id="proposta-gl-almacenaxe"
hint="almacenaxe → almacenamento"

[\b(mini)?aplicativos?\b]i
id="proposta-gl-aplicativo"
hint="aplicativo → aplicación"
validGroup keywords

[\baspas?\b]i
id="proposta-gl-aspas"
hint="aspas → comiñas"

[\bautor(es)?\b]i
id="proposta-gl-autor"
hint="autor → [persoa] autora, autoría"

[\b(micro)?blogs?\b]i
id="proposta-gl-blog"
hint="blog → bitácora"

[(?<!\.)\bcom\b]i
id="proposta-gl-com"
hint="com → con"

[\bcomandos?\b]i
id="proposta-gl-comando"
hint="comando → orde"

[\bconvites?\b]i
id="proposta-gl-convite"
hint="convite → invitación"

[\bCPUs?\b]i
id="proposta-gl-cpu"
hint="CPU → procesador"

[\bdesenvolvedor(es)?\b]i
id="proposta-gl-desenvolvedor"
hint="desenvolvedor → [persoa] desenvolvedora, [equipo] desenvolvedor, desenvolvemento"
valid after="\bequipos?\s+"

[\bdes(?!(exos|exábe(l|is))\b)[eé]x[aáeéoó]]i
id="proposta-gl-desexar"
hint="desexar → querer"
valid before="\w*\s*boa\s*sorte\b"
valid msgstr="\bnon\s*desexad[ao]s?\b"
valid after="\bestamos\s*" msgid="\bcan([’']t|not)\s*wait\b"
valid msgid="\bdesir(e[ds]?|ing)\b"
valid msgid="\btarget\b" msgstr="\bdesexad[ao]s?\b"
valid msgid="\bwishes\b"

[\b(sub\s*-?\s*)?directorios?\b]i
id="proposta-gl-directorio"
hint="directorio → cartafol"
valid before="\s*de\s*LDAP\b"

[:$]
id="proposta-gl-dous-puntos-finais"
hint="A cadea orixinal non remata en «:»."
valid msgid=":$"

[\bempr[eé](g[aáoó]|gu[eé])]i
id="proposta-gl-empregar"
hint="empregar → usar"

[\bespecif(?!ica(cións?|mente)\b)[ií](c[aáoó]|qu[eé])]i
id="proposta-gl-especificar"
hint="especificar → indicar"

[^estase\s+a\s+\w+[aei]r\b]i
id="proposta-gl-estase-a-infinitivo"
hint="Estase a [infinitivo] → [Xerundio]"

[\bexp[ií]r[aáeéoó]]i
id="proposta-gl-expirar"
hint="expirar → caducar, rematar"
validGroup keywords
valid msgid="\bbreath(ed|ing|s)?\s*out\b"

[\bfora\s+d(e|[ao]s?)\b]i
id="proposta-gl-fora"
hint="fora → fóra"

[\bgallas?\b]
id="proposta-gl-galla"
hint="galla → rama"

[\bgantt\b]
id="proposta-gl-gantt"
hint="gantt → Gantt"

[\bGPUs?\b]i
id="proposta-gl-gpu"
hint="GPU → procesador gráfico"

[\bgrellas?\b]i
id="proposta-gl-grella"
hint="grella → grade"

[\s-\s]i
id="proposta-gl-guión"
hint="«-» → «−» (signo de resta) ou «—» (guión longo), o guión curto só se usa para unir palabras, sen espazos arredor."

[\bintimidades?\b]i
id="proposta-gl-intimidade"
hint="intimidade → privacidade"
valid msgid="\bprivacidades?\b"

[\bmantedor(es)?\b]i
id="proposta-gl-mantedor"
hint="mantedor → [persoa] mantedora, [equipo] mantedor, mantemento"
valid after="\bequipos?\s+"

[\bmensaxerías?\b]i
id="proposta-gl-mensaxería"
hint="mensaxería → mensaxaría"

[\b[Mm]ime\b]
id="proposta-gl-mime"
hint="mime → MIME"
valid msgid="\bMIME\b"

[\bm(?!ostra(rios?|xes?)\b)[oó]str[aáeéoó]]i
id="proposta-gl-mostrar"
hint="mostrar → amosar"
valid msgid="\bsampler?s?\b"

[\b[dn]?[ao]s?\s*(Kopete)\b]i
id="proposta-gl-nome-programa"
hint="Non usar artigo cos nomes de programa."

[\borganizador(es)?\b]i
id="proposta-gl-organizador"
hint="organizador → [persoa] organizadora, quen organiza, organización"

[\bp\.ex\.]i
id="proposta-gl-p-ex"
hint="p.ex. → p. ex."

[\bpedidos?\b]i
id="proposta-gl-pedido"
hint="pedido → solicitude"
valid !msgid="\brequests?\b"

[\bpoida\s*que\b]i
id="proposta-gl-poida-que"
hint="poida que → pode que"

[\bpólas?\b]
id="proposta-gl-póla"
hint="póla → rama"

[\bpor\s*favor\b]i
id="proposta-gl-por-favor"
hint="Evite «por favor»"

[\bpr[oó]v(?![eé](dor(es)?\b|n\b|ñ)|[oó](c[aáoó]|qu[eé]))[aáeéoó]]i
id="proposta-gl-provar"
hint="provar → probar"

[\bprogramador(es)?\b]i
id="proposta-gl-programador"
hint="programador → [persoa] programadora, [equipo] programador, programación"
valid after="\bequipos?\s+"

[\bprox(ys?|ies)\b]i
id="proposta-gl-proxy"
hint="proxy → mandatario"
valid msgid="\bmandatarios?\b"
validGroup keywords

[[^.:…!?\s]((\s|\n){2,})?$]
id="proposta-gl-punto-final"
hint="Usa punto final."
valid comment="path: component/name|property \(shortcut\)"
valid !ctx="(?i)(@info:(credit Role|status|usagetip)|QCheckBox|QRadioButton|(tool|usage)tip|whatsthis)" !ctx="^(Comment|Description)$" !comment="(Tag: refpurpose|path: (component/summary|description/p|screenshot/caption)|QCheckBox|QRadioButton|(status|tool)Tip|whatsthis)"
valid ctx="tooltip|whatsthis" msgid=":.*?:"  # Indicadores dunha lista.
valid ctx="@action"
valid comment="KTitleWidget|property \((windowTitle|text\), (item|widget \((KComboBox|Q\w*?(Button|Label|SpinBox))))"
valid msgid="%\d$"

[\bscripts?\b]i
id="proposta-gl-script"
hint="script → guión"

[\bseguranzas?\b]i
id="proposta-gl-seguranza"
hint="seguranza → seguridade"

[\b(ser|é|son)\s*capa(z|ces)\s*de\b]i
id="proposta-gl-ser-capaz"
hint="ser capaz de → poder"

[\b(ser|é|son)\s*necesario\s*\w*[aei]r\b]i
id="proposta-gl-ser-necesario"
hint="ser necesario [infinitivo] → haber que [infinitivo]"

[\bslugs?\b]i
id="proposta-gl-slug"
hint="slug → alias"

[\b(tocs?|táboas?\s*d(e|os)\s*contidos)\b]i
id="proposta-gl-toc"
hint="ToC, táboa de contidos → índice"

[\busuarios?\b]i
id="proposta-gl-usuario"
hint="usuario → [persoa] usuaria, uso"
valid msgstr="\busuarias?\b"

[\butil[ií](z[aáoó]|c[eé])]i
id="proposta-gl-utilizar"
hint="utilizar → usar"

[\bvarelos?\b]
id="proposta-gl-varelo"
hint="varelo → rama"

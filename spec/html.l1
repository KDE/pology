# Lightweight specification of HTML5.

a : download href hreflang media name onclick onmouseout onmouseover ping referrerpolicy rel target title type;
abbr :;
acronym :;
address :;
applet : align archive border code codebase height hspace mayscript name vspace width;
area : alt coords download href hreflang media nohref onclick ping referrerpolicy rel shape target title type;
article :;
aside :;
audio : autoplay controls crossorigin loop muted preload src;
b :;
base : href target;
basefont :;
bdi :;
bdo :;
big :;
blockquote : cite;
body : alink background bgcolor bgproperties leftmargin link marginheight marginwidth onload scroll stylesrc text topmargin vlink;
br : clear;
button : accesskey autofocus disabled form formaction formenctype formmethod formnovalidate formtarget name onclick tabindex type value;
canvas : height width;
caption : align valign;
center :;
cite :;
code :;
col : align bgcolor span width;
colgroup : align span width;
data : value;
datalist :;
dd :;
del : cite datetime;
details : open;
dfn :;
dialog : open;
dir :;
div : align;
dl : compact;
dt :;
em :;
embed : height src type width;
fieldset : disabled form name;
figcaption :;
figure :;
font : color face size;
footer :;
form : accept-charset action autocomplete enctype method name novalidate onreset onsubmit rel target;
frame : bordercolor frameborder marginheight marginwidth name noresize scrolling src;
frameset : border bordercolor cols frameborder framespacing rows;
h1 : align;
h2 : align;
h3 : align;
h4 : align;
h5 : align;
h6 : align;
head :;
header :;
hgroup :;
hr : align color noshade size width;
html :;
i :;
iframe : align allow allowfullscreen frameborder height hspace loading longdesc marginheight marginwidth name referrerpolicy sandbox scrolling src srcdoc vspace width;
img : align alt border controls crossorigin decoding dynsrc height hspace ismap loading longdesc loop lowsrc naturalsizeflag nosave onload referrerpolicy sizes src srcset start suppress usemap vspace width;
input : align alt autocomplete autofocus border checked dirname disabled form formaction formenctype formmethod formnovalidate formtarget height hspace language list lowsrc max maxlength min minlength multiple name onblur onchange onclick onfocus onkeydown onkeypress onkeyup pattern placeholder readonly required size src step tabindex type value vspace width;
ins : cite datetime;
isindex : action prompt;
kbd :;
label : for form;
legend : align;
li : type value;
link : as crossorigin href hreflang integrity media rel rev sizes title type;
main :;
map : name;
mark :;
menu :;
meta : charset content equiv http-equiv name;
meter : form high low max min optimum value;
nav :;
noframes :;
noscript :;
object : data form height name type usemap width;
ol : reversed start type;
optgroup : disabled label;
option : disabled label selected value;
output : for form name;
p : align clear;
param : name value;
picture :;
pre :;
progress : max value;
q : cite;
rp :;
rt :;
ruby :;
s :;
samp :;
script : async charset crossorigin defer event for integrity language nomodule referrerpolicy src type;
search :;
section :;
select : autofocus disabled form language multiple name onblur onchange onfocus readonly required size tabindex;
slot : name;
small :;
source : media sizes src srcset type;
span :;
strike :;
strong :;
style : media nonce type;
sub :;
summary :;
sup :;
table : align background bgcolor border bordercolor bordercolordark bordercolorlight cellpadding cellspacing frame height hspace rules summary vspace width;
tbody :;
td : align background bgcolor bordercolor bordercolordark bordercolorlight colspan headers height nowrap rowspan valign width;
template :;
textarea : autofocus cols dirname disabled form language maxlength minlength name onchange onkeypress placeholder readonly required rows spellcheck tabindex wrap;
tfoot :;
th : abbr align background bgcolor bordercolor bordercolordark bordercolorlight colspan headers height nowrap rowspan scope valign width;
thead :;
time : datetime;
title :;
tr : align background bgcolor bordercolor bordercolordark bordercolorlight halign valign;
track : default kind label src srclang;
tt :;
u :;
ul : type;
var :;
video : autoplay controls crossorigin height loop muted playsinline poster preload src width;
wbr :;
xmp :;

# Dummy tag for common attributes.
pe-common-attrib : accesskey class contenteditable dir draggable hidden id lang role spellcheck style tabindex title translate;
